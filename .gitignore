__pycache__/

# perT_sweep: large weights / transient logs never committed
perT_sweep/**/*.pth
perT_sweep/**/train.log
perT_sweep/**/eval_*.log
perT_sweep/train.lock
perT_sweep/supervisor.lock
perT_sweep/supervisor.log
perT_sweep/supervisor_stdout.log

# perT_sweep_v2: weights / logs stay on the GPU box
perT_sweep_v2/**/*.pth
perT_sweep_v2/**/train.log
perT_sweep_v2/**/*.log

# datasets live in dataset/ and are never committed
dataset/

# local backup of server weights/logs (large)
Remote/
perT_sweep_scaleA/**/*.pth
perT_sweep_scaleA/**/*.log
